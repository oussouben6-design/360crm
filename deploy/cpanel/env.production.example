# =====================================================================
# Excellence 360 CRM — variables de production sur cPanel LWS
#
# Emplacement : ~/apps/excellence360/.env.production
#   cp deploy/cpanel/env.production.example .env.production
#   nano .env.production
#   chmod 600 .env.production
#
# Seuls 5 secrets sont à compléter ci-dessous :
#   1. MOT_DE_PASSE_DB           dans DATABASE_URL (mot de passe PostgreSQL Supabase)
#   2. SUPABASE_SERVICE_ROLE_KEY (Supabase → Project Settings → API → service_role)
#   3. RESEND_API_KEY            (resend.com → API Keys, domaine excellence-services-sarl.com)
#   4. MFA_ENCRYPTION_KEY        générer avec : openssl rand -base64 32
#   5. MAINTENANCE_SECRET        générer avec : openssl rand -hex 32
#
# Après toute modification :
#   touch tmp/restart.txt          (Passenger relance l'application)
#   npm run build                  (si une variable NEXT_PUBLIC_* a changé)
#
# Ne jamais committer ce fichier : il contient les secrets de production.
# =====================================================================

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# ---------------------------------------------------------------------
# Adresse publique — pilote les liens d'e-mail, OAuth et le référencement
# ---------------------------------------------------------------------
APP_URL=https://360crm.excellence-services-sarl.com
NEXT_PUBLIC_SITE_URL=https://360crm.excellence-services-sarl.com

# ---------------------------------------------------------------------
# Base de données : Supabase (pooler port 6543, IPv4 — projet opnlvqwbevnivfjpbrxa)
# ---------------------------------------------------------------------
DATABASE_MODE=postgres
DATABASE_URL=postgresql://postgres.opnlvqwbevnivfjpbrxa:MOT_DE_PASSE_DB@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
DATABASE_POOL_MAX=5
DATABASE_SSL=true
# Le schéma est déjà appliqué sur Supabase (27/27 migrations, dont contact_requests).
AUTO_MIGRATE=false

# ---------------------------------------------------------------------
# Stockage des documents : bucket privé Supabase
# ---------------------------------------------------------------------
STORAGE_DRIVER=supabase
SUPABASE_URL=https://opnlvqwbevnivfjpbrxa.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents
MAX_UPLOAD_BYTES=10485760

# ---------------------------------------------------------------------
# E-mails transactionnels & notifications du formulaire /contact (Resend)
# Contacts officiels : admin@excellence-services-sarl.com · +227 78 79 89 00 · +227 92 80 02 57
# ---------------------------------------------------------------------
MAIL_TRANSPORT=resend
RESEND_API_KEY=
MAIL_FROM=Excellence 360 CRM <admin@excellence-services-sarl.com>
AUTH_LOGIN_OTP=true
AUTH_LOGIN_OTP_GOOGLE=false
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_ALLOW_REGISTRATION=false

# ---------------------------------------------------------------------
# Clés générées une seule fois, puis conservées précieusement
#   MFA_ENCRYPTION_KEY : openssl rand -base64 32
#   MAINTENANCE_SECRET : openssl rand -hex 32
# ---------------------------------------------------------------------
MFA_ENCRYPTION_KEY=
MAINTENANCE_SECRET=

# ---------------------------------------------------------------------
# Connexion Google (facultatif) — URI de redirection Google Cloud :
#   https://360crm.excellence-services-sarl.com/api/auth/google/callback
# ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------
# Assistant IA (connecté en direct aux données CRM)
# ---------------------------------------------------------------------
# Le moteur IA analytique intégré Excellence 360 est actif par défaut sans clé externe.
# Facultatif : ajoutez l'une des clés ci-dessous pour activer un modèle externe :
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=

# ---------------------------------------------------------------------
# Référencement — Google Search Console (facultatif)
# ---------------------------------------------------------------------
GOOGLE_SITE_VERIFICATION=
