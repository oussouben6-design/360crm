# =====================================================================
# Excellence 360 CRM — .htaccess pour le sous-domaine LWS
# Sous-domaine cible : https://360crm.excellence-services-sarl.com
#
# Emplacement : dossier du sous-domaine (ex. public_html/360crm/.htaccess)
# =====================================================================

# --- 1. Phusion Passenger (Node.js sur cPanel LWS) ---------------------------
# Lorsque vous créez l'application dans « cPanel → Setup Node.js App » sur le
# sous-domaine 360crm.excellence-services-sarl.com (startup file : passenger.cjs),
# cPanel ajoute automatiquement PassengerAppRoot et PassengerNodejs en haut ou
# en bas de ce fichier avec le chemin exact de votre compte LWS.
# Si vous installez via SSH (install-on-cpanel.sh), les deux lignes suivantes
# sont activées automatiquement avec votre vrai répertoire $HOME :
PassengerEnabled on
PassengerAppType node
PassengerStartupFile passenger.cjs
PassengerAppEnv production
PassengerFriendlyErrorPages off
# PassengerAppRoot /home/USER/apps/excellence360
# PassengerLogFile /home/USER/logs/excellence360-passenger.log

# --- 2. Redirection HTTPS forcée sur le sous-domaine -------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Bloque tout accès HTTP direct aux dossiers internes si l'archive complète
  # a été extraite dans le dossier du sous-domaine.
  RewriteRule ^(src|supabase|scripts|deploy|node_modules|\.git|\.next)/ - [F,L]

  RewriteCond %{HTTPS} !=on
  RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# --- 3. En-têtes transmis à Next.js (sous-domaine) ---------------------------
<IfModule mod_headers.c>
  RequestHeader set X-Forwarded-Proto "https"
  RequestHeader set X-Forwarded-Host "%{HTTP_HOST}s"
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

# --- 4. Protection des fichiers de configuration et de démarrage -------------
<FilesMatch "(^\.|\.env|package(-lock)?\.json|tsconfig\.json|next\.config\.ts|postcss\.config\.mjs|eslint\.config\.mjs|passenger\.cjs|\.log$|\.sh$|\.md$)">
  Require all denied
</FilesMatch>

Options -Indexes -MultiViews -FollowSymLinks

# --- 5. Cache longue durée pour les assets compilés Next.js ------------------
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
